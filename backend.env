# Environment configuration for BA-Bot backend container
ENV=production
HOST=0.0.0.0
PORT=8000

# Secret key for JWT signature (must be at least 32 characters in production)
JWT_SECRET=secure_jwt_token_secret_key_of_32_characters_minimum

# Database connection details (places sqlite inside the persistent volume)
DATABASE_URL=sqlite:////app/data/ba_bot.db

# Redirect Forjinn predictions to our internal local mock service
PREDICTION_URL=http://127.0.0.1:8000/api/mock-predict

# Allowed CORS origins
FRONTEND_URL=http://localhost,http://127.0.0.1

# Uploads directory
UPLOAD_DIR=/app/uploads

# Rate limits for sensitive/expensive endpoints, as "<count>/<period>" (slowapi format,
# e.g. "5/minute", "100/hour"). Buckets are keyed per client IP (see utils/rate_limit.py);
# behind the bundled Nginx reverse proxy this is the real client IP, not the proxy's.
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_PREDICT=20/minute
RATE_LIMIT_EXPORT=10/minute

# Maximum accepted request Content-Length, in bytes. Requests larger than this are
# rejected before their body is read. Default 4MB (4194304) is roughly double this app's
# largest legitimate payload, to leave headroom for header/framing overhead.
MAX_REQUEST_BODY_BYTES=4194304
