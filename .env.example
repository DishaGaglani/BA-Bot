# Environment (development, production)
ENV=development

# Server startup configuration
HOST=0.0.0.0
PORT=8000

# JWT Secret Key for token signing and authentication
# Note: In production mode, this MUST be set and must be at least 32 characters long.
JWT_SECRET=development_secret_key_change_me_in_production

# Database Connection URL (SQLAlchemy compatible)
# Defaults to a local SQLite database ba_bot.db in the backend folder
# DATABASE_URL=sqlite:///ba_bot.db

# Forjinn Prediction Endpoint / Flow ID
PREDICTION_URL=https://172.16.34.7:3000/api/v1/prediction/09ee3d2d-5d65-4793-a217-abd65e837366

# Frontend URL for CORS configuration (multiple URLs separated by comma)
# FRONTEND_URL=http://localhost:5173,https://your-production-app.com

# Background jobs (all optional; defaults shown)
# JOB_WORKERS=2
# JOB_MAX_ATTEMPTS=3
# JOB_BACKOFF_BASE_SECONDS=5
# JOB_LEASE_SECONDS=600
# JOB_RETENTION_DAYS=7
# LLM_STREAM_WORKERS=16
